---
import aphotos from '../../../data/astro-photos.js';

export async function getStaticPaths() {
  return aphotos.map(aphoto => ({
    params: { slug: aphoto.slug }
  }));
}

const { slug } = Astro.params;
const aphoto = aphotos.find(p => p.slug === slug);
if (!aphoto) throw new Error(`Photo not found: ${slug}`);
---

<html>
  <head>
    <title>MokyNZ's Portfolio | {aphoto.title}</title>
    <style>
      body {
        background: #000;
        color: #eee;
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
      }

      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        border-bottom: 1px solid #ddd;
        font-family: sans-serif;
        background: #111;
      }

      .site-title {
        font-weight: bold;
        font-size: 1.5rem;
        color: #eee;
      }

      nav a {
        text-decoration: none;
        color: #eee;
        font-weight: 600;
        margin-left: 1.5rem;
      }

      nav a:hover {
        color: #66ccff;
      }

      main {
        max-width: 600px;
        margin: 2rem auto;
        padding: 1rem;
      }

      img {
        width: 100%;
        border-radius: 8px;
      }

      ul {
        list-style: none;
        padding: 0;
      }

      li {
        margin-bottom: 0.4rem;
      }

      a.download-btn {
        display: inline-block;
        margin-top: 1rem;
        background: #66ccff;
        color: #000;
        padding: 0.8rem 1.2rem;
        border-radius: 5px;
        text-decoration: none;
      }

      a.download-btn:hover {
        background: #5599dd;
      }

      a.back-link {
        color: #66ccff;
        display: inline-block;
        margin-bottom: 1rem;
        text-decoration: none;
      }

      a.back-link:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="site-title">Portfolio</div>
      <nav>
        <a href="/">Gallery</a>
        <a href="/contact">Contact</a>
    <a href="https://github.com/MokyNZTTV/Portfolio">Github</a>
      </nav>
    </header>
    <main>
      <a class="back-link" href="/">&larr; Back to Gallery</a>
      <h1>{aphoto.title}</h1>
      <img src={aphoto.image} alt={aphoto.title} />
      <p set:html={aphoto.description}></p>
      <h2>Shot Info</h2>
      <ul>
        <li><strong>Camera:</strong> {aphoto.camera}</li>
        <li><strong>Lens:</strong> {aphoto.lens}</li>
        <li><strong>Exposure:</strong> {aphoto.exposure}</li>
        <li><strong>Focal Length:</strong> {aphoto.focal_length}</li>
        <li><strong>Aperture:</strong> {aphoto.aperture}</li>
        <li><strong>ISO:</strong> {aphoto.iso}</li>
        <li><strong>Date:</strong> {aphoto.date}</li>
      </ul>
      <a class="download-btn" href={aphoto.image} download>Download Photo</a>
    </main>
  </body>
</html>
