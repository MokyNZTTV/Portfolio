---
import aphotos from '../data/astro-photos.js';
import bphotos from '../data/other-photos.js';
---

<title>MokyNZ's Portfolio</title>

<style>
  body {
    background: #000000;
    color: #eee;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    border-bottom: 2px solid #68166f;
    font-family: sans-serif;
    background: #111;
  }

  .site-title {
    font-weight: bold;
    font-size: 1.5rem;
    color: #68166f;
  }

  nav a {
    text-decoration: none;
    color: #eee;
    font-weight: 600;
    margin-left: 1.5rem;
  }

  nav a:hover {
    color: #68166f;
  }

  main {
    max-width: 1520px;
    margin: 2rem auto;
    padding: 0 1rem; /* gap from screen edges */
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center; /* THIS centers the rows */
    gap: 2rem;
  }

  a.card {
    color: #eee;
    text-decoration: none;
    border: 2px solid #444;
    border-radius: 8px;
    overflow: hidden;
    display: block;
    transition: border-color 0.3s;
    width: 280px; /* fixed width for cards */
  }

  a.card:hover {
    border-color: #68166f;
  }

  img {
    width: 100%;
    border-radius: 8px;
  }

  h2 {
    margin: 0.5rem;
    font-size: 1.25rem;
  }
</style>

<header>
  <div class="site-title">Portfolio</div>
  <nav>
    <a href="/">Gallery</a>
    <a href="/contact">Contact</a>
    <a href="https://github.com/MokyNZTTV/Portfolio">Github</a>
  </nav>
</header>

<main>
  <div class="grid">
    {aphotos.map(aphoto => (
      <a class="card" href={`/photos/astro/${aphoto.slug}`}>
        <img src={aphoto.preview} alt={aphoto.title} />
        <h2>{aphoto.title}</h2>
      </a>
    ))}
  </div>
  <hr class="site-title" style="border:1px solid #68166f">
  <div class="grid">
    {bphotos.map(bphoto => (
      <a class="card" href={`/photos/other/${bphoto.slug}`}>
        <img src={bphoto.preview} alt={bphoto.title} />
        <h2>{bphoto.title}</h2>
      </a>
    ))}
  </div>
</main>
