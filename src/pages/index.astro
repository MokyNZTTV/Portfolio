---
import photos from '../data/photos.js';
---

<title>MokyNZ's Portfolio</title>

<style>
  body {
    background: #000;
    color: #eee;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    border-bottom: 1px solid #ddd;
    font-family: sans-serif;
    background: #111;
  }

  .site-title {
    font-weight: bold;
    font-size: 1.5rem;
    color: #eee;
  }

  nav a {
    text-decoration: none;
    color: #eee;
    font-weight: 600;
    margin-left: 1.5rem;
  }

  nav a:hover {
    color: #66ccff;
  }

  main {
    max-width: 1520px;
    margin: 2rem auto;
    padding: 0 1rem; /* gap from screen edges */
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center; /* THIS centers the rows */
    gap: 2rem;
  }

  a.card {
    color: #eee;
    text-decoration: none;
    border: 1px solid #444;
    border-radius: 8px;
    overflow: hidden;
    display: block;
    transition: border-color 0.3s;
    width: 280px; /* fixed width for cards */
  }

  a.card:hover {
    border-color: #66ccff;
  }

  img {
    width: 100%;
    border-radius: 8px;
  }

  h2 {
    margin: 0.5rem;
    font-size: 1.25rem;
  }
</style>

<header>
  <div class="site-title">Portfolio</div>
  <nav>
    <a href="/">Gallery</a>
    <a href="/contact">Contact</a>
    <a href="https://github.com/MokyNZTTV/Portfolio">Github</a>
  </nav>
</header>

<main>
  <div class="grid">
    {photos.map(photo => (
      <a class="card" href={`/photos/${photo.slug}`}>
        <img src={photo.image} alt={photo.title} />
        <h2>{photo.title}</h2>
      </a>
    ))}
  </div>
</main>
